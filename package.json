{
  "name": "moscollector-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "ftl": "npm run format && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/vue-query": "^5.103.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "msw": false
  }
}
